# Python
__pycache__/
*.py[cod]
*.egg-info/
.coverage
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Environments and local configuration
.env
.env.*
.venv/
venv/

# Packaging
build/
dist/

# Corpora and checkpoints. Large, regenerable, and not evidence.
data/
checkpoints/

# Calibration is exploratory and must not be mistaken for a registered run.
calibration/

# Local scratch. Research artifacts must be added intentionally.
tmp/

# LaTeX build artifacts. main.pdf is committed deliberately: it is the artifact
# a reviewer reads, and regenerating it needs a TeX install this repo does not
# otherwise require.
paper/arr/*.aux
paper/arr/*.bbl
paper/arr/*.blg
paper/arr/*.fdb_latexmk
paper/arr/*.fls
paper/arr/*.log
paper/arr/*.out
paper/arr/build.log

# Editors and operating systems
.DS_Store
.idea/
.vscode/

# StillMirror session traces: local, regenerated every session, not evidence.
.stillmirror/
